<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jester" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F1016</item>
        <item name="android:statusBarColor">#0F1016</item>
        <item name="android:navigationBarColor">#0F1016</item>
    </style>
    <!-- bottom chat sheet / menu over whatever app is open -->
    <style name="Theme.Jester.Sheet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- share target: no UI of its own, just a toast -->
    <style name="Theme.Jester.Invisible" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
